PORT=3000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=* # Use comma-separated for multi-domain, e.g: domain1.com,domain2.com
# TRUSTED_PROXY=127.0.0.1 # Only set to the address of your actual reverse proxy.

# Swagger Configuration (optional)
# By default, Swagger uses the same origin as the documentation page.
# SWAGGER_PROTOCOL=https
# SWAGGER_HOST=api.example.com:443

# Saweria Credentials
SAWERIA_EMAIL=your-email@example.com
SAWERIA_PASSWORD=your-password

# Browser Configuration (optional)
# CHROME_PATH=/usr/bin/google-chrome-stable  # Linux example
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe  # Windows example
# BROWSER_HEADLESS=true  # Default false (headful via Xvfb on Linux). Set true only if Xvfb unavailable — Turnstile solve rate drops significantly.

# Generate a secret with: openssl rand -hex 32
# If empty, session changes, profile, balances and transaction history are disabled.
ADMIN_KEY=
